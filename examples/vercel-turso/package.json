{
  "name": "durablerun-vercel-turso-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "receipt": "node --env-file-if-exists=.env --import tsx scripts/hosted-receipt.ts",
    "test": "node --import tsx --test test/*.node-test.ts",
