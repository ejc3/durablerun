{
  "release": "v0.1.0-alpha.1",
  "source": "declaration exports of the published release assets, read with the TypeScript compiler API",
  "assets": {
    "durablerun-core-0.1.0-alpha.1.tgz": "a342d4f4323496b55a58cc21b872fccdea9e4b60be9222334aabbd5879b053ed",
    "durablerun-driver-0.1.0-alpha.1.tgz": "181e096a96c0b4fdf2f8cded26adc94b84c61b6391ecf542947e1892d08dbbea",
