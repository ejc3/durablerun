{
  "name": "durablerun",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "build": "pnpm --filter './packages/*' -r --if-present run build",
    "cli": "node --import tsx packages/cli/bin/durablerun.ts",
    "dogfood:start": "node --env-file-if-exists=.env --import tsx apps/dogfood/src/cli.ts start",
    "dogfood:tick": "node --env-file-if-exists=.env --import tsx apps/dogfood/src/cli.ts tick",
    "dogfood:status": "node --env-file-if-exists=.env --import tsx apps/dogfood/src/cli.ts status",
    "dogfood:verify": "node --env-file-if-exists=.env --import tsx apps/dogfood/src/cli.ts verify",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit && tsc -p tsconfig.vitest.json",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format-check": "biome format .",
    "lint:determinism": "bash scripts/determinism-lint.sh",
    "lint:user-boundary": "bash scripts/user-boundary-lint.sh",
    "verify": "pnpm lint && pnpm lint:determinism && pnpm lint:user-boundary && pnpm lint:ledger && pnpm lint:fragments && pnpm lint:batches && pnpm lint:clock && pnpm lint:outcomes && pnpm lint:deferrals && pnpm lint:mutation-verdicts && pnpm lint:selftest && pnpm lint:review-bots && pnpm lint:gate && pnpm format-check && pnpm typecheck && pnpm verify:packages && pnpm test",
    "lint:ledger": "python3 scripts/spec-ledger.py",
    "lint:fragments": "python3 scripts/fragment-lint.py",
    "lint:batches": "python3 scripts/batch-lint.py",
    "lint:clock": "python3 scripts/clock-lint.py",
    "lint:outcomes": "python3 scripts/outcome-lint.py",
    "lint:mutation-verdicts": "python3 scripts/mutation-probe.py --self-test",
    "verify:mutations": "python3 scripts/mutation-probe.py",
    "verify:tla": "bash scripts/confine.sh bash scripts/tla.sh",
    "verify:fuzz": "FUZZ_SEEDS=2000 FUZZ_STEPS=100 bash scripts/confine.sh pnpm exec vitest run packages/conformance/test",
    "verify:fuzz:deep": "FUZZ_SEEDS=100000 FUZZ_STEPS=150 FUZZ_BATCHES=8 bash scripts/confine.sh pnpm exec vitest run packages/conformance/test",
    "verify:packages": "bash scripts/package-smoke.sh && bash scripts/alpha1-compat.sh",
    "lint:selftest": "python3 scripts/lint-selftest.py",
    "lint:deferrals": "python3 scripts/deferral-lint.py",
    "lint:gate": "python3 scripts/gate-lint.py",
    "lint:review-bots": "python3 scripts/review-bot-lint.py"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
