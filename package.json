{
  "name": "durablerun",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format-check": "biome format .",
    "lint:determinism": "bash scripts/determinism-lint.sh",
    "verify": "pnpm lint && pnpm lint:determinism && pnpm lint:ledger && pnpm format-check && pnpm typecheck && pnpm test",
    "lint:ledger": "bash scripts/spec-ledger.sh",
    "verify:tla": "bash scripts/tla.sh",
    "verify:fuzz": "FUZZ_SEEDS=250 FUZZ_STEPS=80 vitest run packages/conformance/test/fuzz.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
