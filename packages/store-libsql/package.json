{
  "name": "@durablerun/store-libsql",
  "version": "0.1.0-alpha.1",
  "description": "SQLite and libSQL scheduler store for durablerun.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejc3/durablerun.git",
    "directory": "packages/store-libsql"
  },
  "homepage": "https://github.com/ejc3/durablerun#readme",
  "bugs": {
    "url": "https://github.com/ejc3/durablerun/issues"
  },
  "main": "./src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.js",
    "./testing": "./src/testing.js"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@durablerun/core": "workspace:*",
    "@libsql/client": "^0.15.0",
    "kysely": "0.29.5"
  }
}
